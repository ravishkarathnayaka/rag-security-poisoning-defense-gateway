# Gateway Cryptographic Configuration
GATEWAY_PROVENANCE_KEY=rag-security-gateway-hmac-master-key-prod-001

# Vector Storage Configuration
CHROMA_PERSIST_DIR=/app/chroma_data
CHROMA_SERVER_HOST=chromadb
CHROMA_SERVER_PORT=8000

# Ingestion Sanitization Thresholds
MAX_DOC_SIZE_BYTES=10485760
CHUNK_SIZE=500
CHUNK_OVERLAP=60
INSTRUCTION_DENSITY_THRESHOLD=0.35
HEURISTIC_RISK_THRESHOLD=0.60

# Retrieval Verification Thresholds
SEMANTIC_ALIGNMENT_MIN_SIMILARITY=0.20
INJECTION_RISK_THRESHOLD=0.50
STRICT_QUARANTINE=true
XML_CONTEXT_TAG=untrusted_retrieved_context

# Server Binding
API_HOST=0.0.0.0
API_PORT=8000
